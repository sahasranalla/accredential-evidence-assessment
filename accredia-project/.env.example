# ACCREDIA - AI-Powered Accreditation Evidence Assistant
# Configuration & Environment Variables

# Optional LLM Configuration (If omitted, ACCREDIA runs in 100% Local Grounded Evidence Mode)
LLM_API_KEY=
LLM_MODEL=gemini-1.5-pro
LLM_BASE_URL=

# Institutional Metadata
INSTITUTION_NAME=Vidyapath Institute of Technology
INSTITUTION_CODE=VITEC
LOCATION=Hyderabad, Telangana, India

# Accreditation Retrieval Engine Parameters
DATABASE_URL=sqlite:///./accredia.db
MIN_EVIDENCE_SCORE=0.55
MAX_SEARCH_RESULTS=10
CITATION_STRICT_MODE=true

# Frontend API URL
VITE_API_URL=http://127.0.0.1:8000
